# Contact form (server action: app/actions/contact.ts)
# Copy to .env.local for development; set the same names in Vercel for production.

# Create at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Inbox that receives contact-form messages.
# With the default shared sender this must be the email your Resend account uses.
CONTACT_TO_EMAIL=you@example.com

# Optional. Defaults to onboarding@resend.dev. Set to an address on a domain you
# have verified in Resend to deliver to any inbox.
# CONTACT_FROM_EMAIL=contact@your-domain.com
